server {
    listen 80;
    server_name con.wxxydouge.icu;

    # 控制端只有 JSON 接口和一个管理页，不需要大请求体
    client_max_body_size 64k;

    location / {
        proxy_pass http://127.0.0.1:8100;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        proxy_connect_timeout 5s;
        proxy_read_timeout 15s;
    }

    # 设备登记限流（应用内还有一层内存限流，这里是兜底）
    location = /api/v1/devices/register {
        limit_req zone=control_register burst=20 nodelay;
        proxy_pass http://127.0.0.1:8100;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
    }

    # 管理页只允许自己访问：把家里的 IP 填进 allow，或直接注释掉整段
    # location /admin {
    #     allow 1.2.3.4;
    #     deny all;
    #     proxy_pass http://127.0.0.1:8100;
    # }

    access_log /var/log/nginx/control.access.log;
    error_log  /var/log/nginx/control.error.log;
}

# 放在 http {} 块里（例如 /etc/nginx/nginx.conf 或 conf.d/limit.conf）
# limit_req_zone $binary_remote_addr zone=control_register:10m rate=30r/m;
