server {
    listen 80;
    server_name con.wxxydouge.icu;

    # 🔴 2026-11-04 修正：这里原来写 64k，但 /api/v1/resource-uploads 允许
    #    总 80MB（服务端 _MAX_TOTAL_BYTES、客户端 maxTotal 都是 80MB）。
    #    64k 会让任何真实上传在 nginx 读完 body 之前就被 413 掐断，
    #    客户端只能看到「上传失败（HTTP 413）」或误报成网络问题。
    #    线上（/etc/nginx/sites-enabled/control）实测是 100m —— 本样例文件
    #    是重建服务器的唯一依据，必须与线上一致，否则照它建就是坏的。
    client_max_body_size 100m;

    location / {
        proxy_pass http://127.0.0.1:8100;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        proxy_connect_timeout 5s;
        # 15s 只够小 JSON；80MB 上传在校园网/移动网络下远超此值，
        # 会在服务端写盘期间被 504 掐断。线上同样是 300s。
        proxy_read_timeout 300s;
        proxy_send_timeout 300s;
    }

    # 设备登记限流（应用内还有一层内存限流，这里是兜底）
    location = /api/v1/devices/register {
        limit_req zone=control_register burst=20 nodelay;
        proxy_pass http://127.0.0.1:8100;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
    }

    # 管理页只允许自己访问：把家里的 IP 填进 allow，或直接注释掉整段
    # location /admin {
    #     allow 1.2.3.4;
    #     deny all;
    #     proxy_pass http://127.0.0.1:8100;
    # }

    access_log /var/log/nginx/control.access.log;
    error_log  /var/log/nginx/control.error.log;
}

# 放在 http {} 块里（例如 /etc/nginx/nginx.conf 或 conf.d/limit.conf）
# limit_req_zone $binary_remote_addr zone=control_register:10m rate=30r/m;
